def sudia(n, t):
    if n == 1:
        if not t:
            return 1
        else:
            return -1
    tc = [0] * (n + 1)
    tb = [0] * (n + 1)
    for a, b in t:
        tb[a] += 1
        tc[b] += 1
    for i in range(1, n + 1):
        if tb[i] == 0 and tc[i] == n - 1:
            return i
    return -1
print(sudia(2, [[1,2]]))
print(sudia(3, [[1,3],[2,3]]))
print(sudia(3, [[1,3],[2,3],[3,1]]))


def goroda(c):
    if not c:
        return True

    o = [0] * 26
    i = [0] * 26
    a = [[] for i in range(26)]

    for x in c:
        f = x[0]
        l = x[-1]
        o[ord(f) - 97] += 1
        i[ord(l) - 97] += 1
        a[ord(f) - 97].append(ord(l) - 97)

    s = []
    e = []

    for n in range(26):
        d = o[n] - i[n]
        if d == 1:
            s.append(n)
        elif d == -1:
            e.append(n)
        elif d != 0:
            return False

    if len(s) > 1 or len(e) > 1:
        return False

    v = [False] * 26
    st = []

    def d(u):
        while a[u]:
            v = a[u].pop()
            d(v)
        st.append(u)

    st_n = ord(c[0][0]) - 97
    if s:
        st_n = s[0]

    d(st_n)

    return len(st) == len(c) + 1


ct = input().split()
print(goroda(ct))
